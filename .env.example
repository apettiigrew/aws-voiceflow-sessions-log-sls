# AWS API Gateway api key
# Note!!! This is the same as the webhook secret inside voiceflow settings page
AWS_HTTP_API_KEY=

# API Key for voiceflow
VOICEFLOW_API_KEY=

# Voiceflow base url for dialog management api
VOICEFLOW_BASEURL=https://general-runtime.voiceflow.com

# Voiceflow environment being targeted.
VOICEFLOW_VERSIONID=development